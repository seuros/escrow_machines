module EscrowMachines
  VERSION: String
  CAPACITY: Integer

  # Every refusal symbol. A refused call changed nothing. Each method below
  # lists exactly the ones it can answer. No answer records a clock: escrow
  # takes none. Four refusals carry a number in the core and are bare symbols
  # here; read the number instead: :insufficient from `available`,
  # :exceeds_spent from `outstanding(local)`, :stale_id from
  # `last_transfer(local, to).id`, :id_conflict from `last_transfer(from,
  # to).amount`.
  type refusal = :zero_amount | :insufficient | :exceeds_spent | :unknown_replica | :self_transfer
               | :stale_id | :id_conflict | :malformed | :forged | :config_mismatch | :diverged
               | :overdrawn | :overflow

  # Validated like the core's `Receipt::new`: RangeError when `from == to`,
  # `amount` is zero or `amount` exceeds `total`, or a field is outside
  # 0..2**64-1; TypeError for a non-Integer.
  class Receipt < Data
    attr_reader from: Integer
    attr_reader to: Integer
    attr_reader id: Integer
    attr_reader amount: Integer
    attr_reader total: Integer
    def self.new: (Integer from, Integer to, Integer id, Integer amount, Integer total) -> Receipt
                | (from: Integer, to: Integer, id: Integer, amount: Integer, total: Integer) -> Receipt
  end

  # Mirrors the core's `Transfer`: one `Data` per variant, each carrying the
  # receipt to deliver. TypeError unless `receipt` is a Receipt.
  module Transfer
    class Applied < Data
      attr_reader receipt: Receipt
      def self.new: (Receipt receipt) -> Applied
                  | (receipt: Receipt) -> Applied
    end

    class Replayed < Data
      attr_reader receipt: Receipt
      def self.new: (Receipt receipt) -> Replayed
                  | (receipt: Receipt) -> Replayed
    end
  end

  type transfer = Transfer::Applied | Transfer::Replayed

  # Mirrors the core's `Mark`, validated like `Mark::new`: RangeError for an
  # `amount` of zero or a field outside 0..2**64-1, TypeError for a
  # non-Integer.
  class Mark < Data
    attr_reader id: Integer
    attr_reader amount: Integer
    def self.new: (Integer id, Integer amount) -> Mark
                | (id: Integer, amount: Integer) -> Mark
  end

  class Escrow
    # Bytes of an `encode` frame.
    ENCODED_LEN: Integer

    # The arguments of the core's `Escrow::new`, in order: the local replica
    # and every replica's starting rights. Raises RangeError when the core
    # answers `ConfigError`: no replica, more than CAPACITY, a `local` outside
    # `allotted`, or a supply past 2**64-1.
    def self.new: (Integer local, Array[Integer] allotted) -> Escrow
    # Raises RangeError for a frame the core cannot decode, TypeError for a
    # non-String.
    def self.decode: (String bytes) -> Escrow
    def encode: () -> String
    # Honoured: the rights this replica has left. Refused: :zero_amount,
    # :insufficient, :overflow.
    def spend: (Integer amount) -> (Integer | :zero_amount | :insufficient | :overflow)
    # Honoured: the rights this replica now holds. Refused: :zero_amount,
    # :exceeds_spent, :overflow.
    def refund: (Integer amount) -> (Integer | :zero_amount | :exceeds_spent | :overflow)
    # Honoured: a Transfer::Applied, or the repeat Transfer::Replayed. Refused:
    # :zero_amount, :unknown_replica, :self_transfer, :stale_id, :id_conflict,
    # :insufficient, :overflow.
    def transfer: (Integer to, Integer id, Integer amount)
                -> (transfer | :zero_amount | :unknown_replica | :self_transfer | :stale_id | :id_conflict
                    | :insufficient | :overflow)
    # Honoured: :applied, or the repeat :replayed. Refused: :unknown_replica,
    # :malformed, :id_conflict, :forged, :overflow. A Receipt cannot name one
    # replica twice, so :self_transfer is `transfer`'s alone.
    def accept: (Receipt receipt)
              -> (:applied | :replayed | :unknown_replica | :malformed | :id_conflict | :forged | :overflow)
    # Honoured: :merged. Refused: :config_mismatch, :diverged, :overflow.
    def merge: (Escrow other) -> (:merged | :config_mismatch | :diverged | :overflow)
    # Honoured: :recovered. Refused: :config_mismatch, :diverged, :overdrawn,
    # :overflow.
    def recover: (Escrow other) -> (:recovered | :config_mismatch | :diverged | :overdrawn | :overflow)
    def local: () -> Integer
    def replicas: () -> Integer
    def capacity: () -> Integer
    def supply: () -> Integer
    def available: () -> Integer
    def allotted: (Integer replica) -> Integer?
    def balance: (Integer replica) -> Integer?
    def spent: (Integer replica) -> Integer?
    def refunded: (Integer replica) -> Integer?
    def outstanding: (Integer replica) -> Integer?
    def granted: (Integer from, Integer to) -> Integer?
    def last_transfer: (Integer from, Integer to) -> Mark?
  end
end
